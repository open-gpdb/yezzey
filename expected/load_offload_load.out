----------------------------------------------------------
 offloaded relation public.regaotylol to external storage
(1 row)

SELECT reltablespace FROM pg_class where oid = 'regaotylol'::regclass::oid;
 reltablespace 
---------------
          8555
(1 row)

SELECT count(1) FROM regaotylol;
