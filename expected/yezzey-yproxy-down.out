-- Error-path checks for operations while yproxy is down.
CREATE EXTENSION yezzey VERSION '1.0';
SET client_min_messages TO WARNING;
CREATE TABLE yproxy_down_ao(i INT) WITH (appendonly=true) DISTRIBUTED BY (i);
INSERT INTO yproxy_down_ao SELECT * FROM generate_series(1, 10000);
SELECT yezzey_define_offload_policy('yproxy_down_ao');
 yezzey_define_offload_policy 
------------------------------
 
(1 row)

-- Kill yproxy so all external-storage operations must fail.
SET client_min_messages TO NOTICE;
-- Offloading a new table while yproxy is down must raise an error.
CREATE TABLE yproxy_down_fail(i INT) WITH (appendonly=true) DISTRIBUTED BY (i);
INSERT INTO yproxy_down_fail SELECT * FROM generate_series(1, 1000);
DO $$
BEGIN
    PERFORM yezzey_define_offload_policy('yproxy_down_fail');
    RAISE NOTICE 'unexpected: no error raised';
EXCEPTION WHEN OTHERS THEN
    RAISE NOTICE 'caught error on offload';
END;
$$;
NOTICE:  caught error on offload
-- Loading a relation back while yproxy is down must raise an error.
DO $$
BEGIN
    PERFORM yezzey_load_relation('yproxy_down_ao', NULL);
    RAISE NOTICE 'unexpected: no error raised';
EXCEPTION WHEN OTHERS THEN
    RAISE NOTICE 'caught error on load';
END;
$$;
NOTICE:  caught error on load
SET client_min_messages TO WARNING;
DROP TABLE yproxy_down_fail;
-- Restart yproxy and verify normal operation resumes.
CREATE TABLE yproxy_down_recover(i INT) WITH (appendonly=true) DISTRIBUTED BY (i);
INSERT INTO yproxy_down_recover SELECT * FROM generate_series(1, 1000);
SELECT yezzey_define_offload_policy('yproxy_down_recover');
 yezzey_define_offload_policy 
------------------------------
 
(1 row)

SELECT count(1) AS recovered_rows
FROM yezzey.offload_metadata
WHERE reloid = 'yproxy_down_recover'::regclass AND relpolicy = 1;
 recovered_rows 
----------------
              1
(1 row)

DROP TABLE yproxy_down_ao;
DROP TABLE yproxy_down_recover;
DROP EXTENSION yezzey;
CHECKPOINT;
